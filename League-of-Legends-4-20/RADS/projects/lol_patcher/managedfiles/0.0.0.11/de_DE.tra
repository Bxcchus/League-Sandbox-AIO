tr "quit_warning_body" = "Möchtest du wirklich aussteigen? Wenn du das Startprogramm beendest, kannst du keinen Spielen beitreten, während du beim PvP.net angemeldet bist."
tr "quit_warning_button_accept" = "Ja"
tr "quit_warning_button_reject" = "Nein"

tr "validate_warning_title" = "Reparatur durchführen?"
tr "validate_warning_body" = "Hiermit wird deine Installation nach beschädigten Dateien durchsucht und diese werden bei Bedarf repariert. Dies kann sehr lange dauern. Durch die Reparatur werden zudem alle gespeicherten angepassten Gegenstandssets, die du hast, gelöscht. Möchtest du wirklich fortfahren?"
tr "validate_warning_button_accept" = "Ja"
tr "validate_warning_button_reject" = "Nein"

tr "unsafe_uninstall_title" = "Möglicherweise unsichere Installation"
tr "unsafe_uninstall_message" = "Der PVP.net-Patcher hat festgestellt, dass du eine Installation von League of Legends besitzt, deren Entfernung wegen eines Fehlers in älteren Installationsroutinen Dateien auf deinem Computer beschädigen könnte. Ein Korrekturprogramm wird jetzt heruntergeladen. Gegebenenfalls wirst du um Erlaubnis gebeten, Dateien verändern zu lassen. Bitte stimme dieser Aufforderung zu."
tr "unsafe_uninstall_warning" = "Das Programm zur Fehlerkorrektur konnte nicht richtig ausgeführt werden oder erhielt nicht die notwendigen Rechte. Dateien auf deinem Computer könnten weiterhin gefährdet sein. Dieser Prozess wird beim nächsten Start des Spiels automatisch erneut versucht, bis das Problem behoben wurde."
tr "unsafe_uninstall_success" = "Das Problem wurde erfolgreich behoben. Es sollten keine weiteren Dateien dadurch gefährdet sein. Danke für deine Geduld."

tr "soft_repair_notification_title" = "Möglicher Dateifehler festgestellt"
tr "soft_repair_notification_body" = "Entschuldigung! Wir haben in deiner Installation einen möglichen Dateifehler festgestellt. Möchtest du, dass die betroffenen Dateien repariert werden?"
tr "soft_repair_notification_button_ok" = "OK"
tr "soft_repair_notification_button_quit" = "Beenden"

