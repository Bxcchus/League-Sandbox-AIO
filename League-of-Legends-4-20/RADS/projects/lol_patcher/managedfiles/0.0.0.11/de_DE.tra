tr "initial_popup_header" = "Der Patchvorgang sieht nun anders aus!"
tr "initial_popup_body_1" = "Wir haben ein paar optische Aktualisierungen am Patcher und der Startseite, der ersten Seite, die ihr seht, nachdem ihr euch eingeloggt habt, vorgenommen. Wir wissen, dass dies nur der erste Schritt im Zuge eines großen Projektes ist, aber wir möchten euch einen Eindruck davon geben, wo der Weg hinführt."
tr "initial_popup_body_2" = "Erfahrt in unserem Blog mehr darüber, wie wir uns eure Erfahrung vor dem Spielbeginn vorstellen."
tr "initial_popup_close" = "Schließen"
tr "initial_popup_learn_more" = "Erfahrt mehr"

tr "pando_removal_popup_header" = "Pando Media Booster entfernen?"
tr "pando_removal_popup_body_1" = "Wir haben festgestellt, dass auf deinem Computer der Pando Media Booster installiert ist. League of Legends hat diesen vor einiger Zeit genutzt, um den Downloadvorgang zu beschleunigen, doch jetzt bewirkt er eigentlich nichts mehr und wird auch nicht länger unterstützt."
tr "pando_removal_popup_body_2" = "Wir möchten dich ermutigen, ihn zu deinstallieren. Sollen wir ihn für dich entfernen?"
tr "pando_removal_failed_popup_header" = "Upps! Das Entfernen von Pando ist fehlgeschlagen."
tr "pando_removal_failed_popup_body_1" = "Beim letzten Versuch, den Pando Media Booster zu entfernen, ist etwas schief gelaufen."
tr "pando_removal_failed_popup_body_2" = "Sollen wir es noch einmal versuchen?"
tr "pando_removal_popup_yes" = "Klar!"
tr "pando_removal_popup_no" = "Nicht jetzt"
tr "pando_removal_popup_never" = "Fragt mich nicht noch einmal"


