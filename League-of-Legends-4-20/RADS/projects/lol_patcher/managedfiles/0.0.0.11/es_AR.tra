tr "validate_warning_button_accept" = "Sí"
tr "validate_warning_button_reject" = "No"

tr "unsafe_uninstall_title" = "Instalación potencialmente insegura"
tr "unsafe_uninstall_message" = "El instalador de PVP.net ha detectado que tienes una versión de League of Legends que puede dañar los archivos de tu sistema cuando se desinstale, a causa de un error de las versiones obsoletas del software. A continuación, se ejecutará un programa para corregir este problema. Tal vez te solicite una autorización para modificar archivos. En ese caso, concédesela."
tr "unsafe_uninstall_warning" = "El programa de reparación del desinstalador no se ha ejecutado correctamente o no se le han concedido las autorizaciones necesarias. Tu sistema puede seguir estando en riesgo. Este proceso se repetirá automáticamente la próxima vez que se ejecute el juego y hasta que se hayan corregido los problemas."
tr "unsafe_uninstall_success" = "Se han corregido correctamente los problemas. Tus archivos ya no deben estar en riesgo. Gracias por tu paciencia."

tr "soft_repair_notification_title" = "Detectada una posible corrupción de datos"
