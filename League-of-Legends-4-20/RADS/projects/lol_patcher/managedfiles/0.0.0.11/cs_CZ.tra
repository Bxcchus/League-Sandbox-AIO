tr "unsafe_uninstall_title" = "Nebezpečná instalace"
tr "unsafe_uninstall_message" = "Nástroj pro aktualizaci PVP.net zjistil, že máš nainstalovanou verzi League of Legends, která kvůli chybě, jež byla přítomná ve starších verzích instalátorů LoL, může při odinstalaci poškodit soubory na počítači. Nyní bude spuštěn program, který tento problém odstraní. Pokud tě o to program požádá, uděl mu prosím povolení ke změně souborů."
tr "unsafe_uninstall_warning" = "Program pro opravu odinstalační rutiny neproběhl úspěšně, nebo mu nebyla udělena požadovaná oprávnění. Počítač může být i nadále ohrožen. Tento proces proběhne automaticky při každém spuštění, dokud nebude problém odstraněn."
tr "unsafe_uninstall_success" = "Problémy byly úspěšně vyřešeny. Tvé soubory by již měly být v bezpečí. Děkujeme za trpělivost."

