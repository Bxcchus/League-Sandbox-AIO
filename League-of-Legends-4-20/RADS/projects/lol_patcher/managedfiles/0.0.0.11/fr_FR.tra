tr "validate_warning_button_accept" = "Oui"
tr "validate_warning_button_reject" = "Non"

tr "unsafe_uninstall_title" = "Installation potentiellement à risque"
tr "unsafe_uninstall_message" = "Le patcher PVP.net a détecté que votre installation de League of Legends pourrait endommager des fichiers de votre ordinateur au moment de la désinstallation, en raison d'un bug lié aux anciens programmes d'installation de LoL. Un programme va maintenant corriger ce problème. La modification des fichiers peut nécessiter votre permission ; merci d'autoriser la modification."
tr "unsafe_uninstall_warning" = "Le programme de correction n'a pas été lancé correctement ou n'a pas obtenu l'autorisation nécessaire. Il peut encore y avoir un risque pour votre ordinateur. Ce processus se lancera à nouveau automatiquement au prochain démarrage du jeu, jusqu'à ce que les problèmes aient été corrigés."
tr "unsafe_uninstall_success" = "Les problèmes ont été corrigés. Il ne devrait plus y avoir de risque pour vos fichiers. Merci pour votre patience."

tr "soft_repair_notification_title" = "Données potentiellement corrompues"
