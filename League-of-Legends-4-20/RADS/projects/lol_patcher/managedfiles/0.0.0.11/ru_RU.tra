tr "validate_warning_button_accept" = "Да"
tr "validate_warning_button_reject" = "Нет"

tr "unsafe_uninstall_title" = "Вероятность небезопасной установки"
tr "unsafe_uninstall_message" = "Программа обновления PvP.net обнаружила, что установленная версия League of Legends при удалении может повредить файлы на вашем компьютере в связи с ошибкой в старых программах установки LoL. Сейчас будет запущена программа для устранения этой проблемы. Возможно программа попросит разрешение на изменение файлов. Предоставьте ей доступ."
tr "unsafe_uninstall_warning" = "Программа для исправления деинсталлятора была запущена с ошибкой или не был получен необходимый доступ. Ваш компьютер все еще может быть под угрозой. Этот процесс запустится автоматически при следующем включении игры, до тех пор, пока ошибка не будет устранена."
tr "unsafe_uninstall_success" = "Проблемы были успешно исправлены. Ваши файлы больше не подвергаются риску. Спасибо за терпение."

