tr "unsafe_uninstall_title" = "Possibile installazione non sicura"
tr "unsafe_uninstall_message" = "L'applicatore di patch di PVP.net ha rilevato un'installazione di League of Legends che potrebbe danneggiare i file sul computer quando viene installato, a causa di un bug nelle vecchie installazioni di LoL. Verrà avviato un programma per risolvere il problema. Potrebbe richiedere il permesso di modificare i file. Si consiglia di accordarlo."
tr "unsafe_uninstall_warning" = "Il programma per risolvere i problemi della disinstallazione non è stato eseguito in maniera corretta, o non ha avuto le autorizzazioni necessarie. Il processo si riavvierà automaticamente al prossimo avvio, finché il problema non verrà risolto."
tr "unsafe_uninstall_success" = "I problemi sono stati risolti. I tuoi file non sono più a rischio. Ti ringraziamo per la pazienza."

tr "soft_repair_notification_title" = "Possibili dati danneggiati rilevati"
