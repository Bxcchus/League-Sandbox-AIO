tr "validate_warning_title" = "Potwierdź naprawę"
tr "validate_warning_body" = "To spowoduje przeskanowanie plików instalacyjnych w poszukiwaniu błędów i naprawi je. Zajmie to długi czas. Naprawa usunie wszystkie zapisane zestawy przedmiotów. Na pewno chcesz kontynuować?"
tr "validate_warning_button_accept" = "Tak"
tr "validate_warning_button_reject" = "Nie"

tr "unsafe_uninstall_title" = "Prawdopodobieństwo posiadania niebezpiecznej wersji"
tr "unsafe_uninstall_message" = "Patcher PVP.net wykrył, że posiadasz wersję League of Legends, która przy deinstalacji może uszkodzić pliki na twoim komputerze z powodu błędu w starych instalatorach LoL-a. Uruchomiony zostanie program, który rozwiąże ten problem. Może on poprosić o zezwolenie na modyfikacje plików, pozwól mu na to."
tr "unsafe_uninstall_warning" = "Program, mający naprawić deinstalator nie uruchomił się prawidłowo bądź nie otrzymał pozwolenia na dostęp do plików. Twój komputer może wciąż być narażony na ryzyko. Proces ten powtórzy się automatycznie przy następnym uruchomieniu gry, dopóki problemy nie zostaną rozwiązane."
tr "unsafe_uninstall_success" = "Problemy zostały rozwiązane. Pliki nie powinny być narażone na ryzyko. Dziękujemy za cierpliwość."

