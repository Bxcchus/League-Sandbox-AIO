tr "validate_warning_title" = "Confirmaţi repararea"
tr "validate_warning_body" = "Instanţa de joc instalată va fi scanată pentru a identifica şi repara fişierele corupte. Procesul va dura mult timp. De asemenea, repararea va şterge orice Set de obiecte personalizate deţinut de tine. Eşti sigur că doreşti să continui?"
tr "validate_warning_button_accept" = "Da"
tr "validate_warning_button_reject" = "Nu"

tr "unsafe_uninstall_title" = "Instalare potenţial nesigură"
tr "unsafe_uninstall_message" = "Corectorul PVP.net a detectat faptul că instanţa de League of Legends pe care o aveţi instalată vă poate avaria fişierele la dezinstalare din cauza unei erori din programele de instalare LoL mai vechi. Acum se va lansa un program care va repara eroarea. S-ar putea să vă ceară permisiunea de a modifica fişiere; permiteţi accesul dacă vi se cere."
tr "unsafe_uninstall_warning" = "Programul de reparare a aplicaţiei de instalare nu a funcţionat corect sau nu i s-a acordat permisiunea necesară. Computerul dvs. poate fi încă în pericol. Acest proces se va repeta automat la următoarea rulare a jocului, până când erorile vor fi corectate."
tr "unsafe_uninstall_success" = "Erorile au fost corectate. Acum, fişierele dvs. nu mai sunt în pericol. Vă mulţumim pentru răbdare."

tr "soft_repair_notification_title" = "Posibilă alterare a datelor detectată"
tr "soft_repair_notification_body" = "Ne pare rău! Am detectat o posibilă alterare a datelor la instalare.  Vrei să repari fişierele afectate?"
tr "soft_repair_notification_button_ok" = "OK"
tr "soft_repair_notification_button_quit" = "Renunţă"

