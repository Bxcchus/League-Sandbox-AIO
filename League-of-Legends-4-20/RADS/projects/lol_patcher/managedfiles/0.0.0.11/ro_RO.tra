tr "pando_removal_popup_header" = "Ștergi Pando Media Booster?"
tr "pando_removal_popup_body_1" = "Am detectat că ai Pando Media Booster instalat pe calculatorul tău.  League of Legends l-a folosit în trecut pentru a accelera download-urile, dar acum nu mai face nimic și nu mai este un program suportat."
tr "pando_removal_popup_body_2" = "Te încurajăm să îl dezinstalezi – vrei să îl ștergem noi în locul tău?"
