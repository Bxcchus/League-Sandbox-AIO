tr "validate_warning_title" = "Xác nhận chỉnh sửa"
tr "validate_warning_body" = "Hệ thống sẽ quát bộ cài đặt của bạn để tìm các tập tin bị hỏng rồi sửa chúng. Dự tính sẽ mất khá nhiều thời gian. Ngoài ra quá trình sửa chữa này cũng sẽ xóa bất kì Bộ Trang Bị nào bạn lưu lại. Bạn có chắc là muốn tiếp tục không?"
tr "validate_warning_button_accept" = "Có"
tr "validate_warning_button_reject" = "Không"

tr "unsafe_uninstall_title" = "Bộ cài đặt không ổn định"
tr "unsafe_uninstall_message" = "PVP.net thông báo rằng phiên bản cài đặt Liên Minh Huyền Thoại của bạn có thể đã gây tổn hại đến những tập tin trên máy tính của bạn khi bị gỡ bỏ ra, điều này có thể do lỗi của phiên bản cài đặt Liên Minh Huyền Thoại cũ. Một chương trình sẽ tự động chạy để giải quyết vấn đề này. Có thể sẽ cần đến sự chấp thuận của bạn để chỉnh sửa, vui lòng chấp nhận nếu có yêu cầu."
tr "unsafe_uninstall_warning" = "Chương trình chỉnh sửa không hoàn tất, hoặc chưa được chấp thuận. Máy tính của bạn vẫn có thể gặp rủi ro. Quá trình này sẽ tự động lặp lại lần kế tiếp bạn chạy trò chơi, cho đến khi vấn đề được giải quyết."
tr "unsafe_uninstall_success" = "Vấn đề đã được giải quyết ổn thỏa. Các tập tin của bạn sẽ không còn bị tổn hại nữa. Cám ơn vì sự kiên nhẫn của các bạn."

