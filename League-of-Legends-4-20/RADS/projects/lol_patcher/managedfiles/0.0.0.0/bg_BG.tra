tr "mac_beta_end_message_title" = "Closed Beta for Mac Client is over"
tr "mac_beta_end_message_body" = "Beginning September 6, 2011, the Mac client will no longer enable access to League of Legends. Riot Games is committed to building a solution that will work on the Mac in the long run, and we will notify you first when a new client is available to Mac players. Please visit our Mac Testing forum announcement for more details, and to learn how to redeem your Mac beta reward. "
tr "mac_beta_end_message_accept" = "Announcement"
tr "mac_beta_end_message_reject" = "Close"
tr "mac_beta_end_message_url" = "http://na.leagueoflegends.com/board/showthread.php?t=1185192"